  - "OFL-1.1"
  - "MIT"
repository-code: "https://github.com/Moirania/Anthropic-Serif-CJK-Extension"
keywords:
  - fonts
  - typography
  - cjk
  - chinese
  - fonttools
  - unicode
version: "1.0.0"
date-released: "2026-11-19"
